# 证书方式 internal:Caddy 内置 CA 自签,离线可用,浏览器首次访问需信任根证书
{$WS_SITE_ADDRESS} {
	tls internal
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
	}
	encode gzip
	handle /api/* {
		# 请求体上限(L157):课表 CSV 等上传都远小于 4 MB,过大的请求在这里就被 413 拒绝,不占应用的内存
		request_body {
			max_size 4MB
		}
		reverse_proxy app:8080
	}
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}
