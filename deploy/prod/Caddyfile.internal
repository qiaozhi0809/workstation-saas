# 证书方式 internal:Caddy 内置 CA 自签,离线可用,浏览器首次访问需信任根证书
{$WS_SITE_ADDRESS} {
	tls internal
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
	}
	encode gzip
	handle /api/* {
		reverse_proxy app:8080
	}
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}
