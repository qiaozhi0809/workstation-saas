# 复制为 .env 后使用(install.sh 会自动生成并填好密钥,权限 600)。密钥一律留空,切勿提交真实值。

# 镜像版本号,与 workstation-app / workstation-web / workstation-stream 镜像标签一致
WS_VERSION=0.0.0-dev
# 运行环境:prod 会拒绝默认密钥
WS_ENV=prod
# 学校 ID(单校部署固定一个)
WS_SCHOOL_ID=11111111-1111-1111-1111-111111111111
# 数据库连接串,密码须与下面的 POSTGRES_PASSWORD 一致(install.sh 自动填写)
WS_DATABASE_URL=postgresql+psycopg://workstation:@postgres:5432/workstation
# Redis 连接串(compose 内网,不对外)
WS_REDIS_URL=redis://redis:6379/0
# JWT 签名密钥,至少 32 个字符(install.sh 随机生成)
WS_JWT_SECRET=
# 主密钥,32 字节的 base64(用于加密 AI Key 等字段;丢失后无法解密,务必随备份保存)
WS_MASTER_KEY=
# 可信代理网段,与 compose 固定子网一致,只在来自该网段时才采信 X-Forwarded-For
WS_TRUSTED_PROXIES=172.30.0.0/24
# 站点访问地址:域名或 IP,例如 school.example.test 或 192.168.1.10
WS_SITE_ADDRESS=localhost
# HTTPS 证书方式:internal(内置自签)、custom(自备证书放 certs/)、acme(自动申请,需联网)
WS_TLS_MODE=internal
# acme 模式下用于申请证书的联系邮箱;其他模式留空
WS_ACME_EMAIL=
# 数据库密码(install.sh 随机生成)
POSTGRES_PASSWORD=
# 对外 HTTP 端口
WS_HTTP_PORT=80
# 对外 HTTPS 端口
WS_HTTPS_PORT=443
# 应用与定时任务使用的时区(IANA 名称),影响日志时间与每日定时任务的触发时刻;国内学校一般不用改
TZ=Asia/Shanghai
# 同时转流的摄像头路数上限,再多的播放请求会提示"同时观看的摄像头太多"(copy 模式每路约 0.1 核,转码每路约 1 核)
WS_STREAM_MAX=10
# 转流容器(stream-worker)的 CPU 上限(核数);勾选"转码"的摄像头多时调大
WS_STREAM_CPUS=2
# 转流容器的内存上限(如 2g、4096m)
WS_STREAM_MEMORY=2g
# 直播片段内存盘(tmpfs)的上限,只按实际用量占内存:主码流每路约 60–100 MB,子码流每路不到 20 MB
WS_HLS_SIZE=1g
