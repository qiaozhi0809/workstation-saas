WS_ENV=dev
WS_DATABASE_URL=postgresql+psycopg://workstation:workstation@localhost:5432/workstation
WS_REDIS_URL=redis://localhost:6379/0
WS_SCHOOL_ID=11111111-1111-1111-1111-111111111111
WS_JWT_SECRET=CHANGE_ME_32_BYTES_MIN
WS_LOG_LEVEL=INFO
